<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6-create-analysis-history-table" author="devtrends">
        <createTable tableName="analysis_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="repo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="calculated_score" type="DOUBLE"/>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="7-add-analysis-history-foreign-key" author="devtrends">
        <addForeignKeyConstraint baseTableName="analysis_history" baseColumnNames="repo_id"
                                 constraintName="fk_analysis_repo"
                                 referencedTableName="repositories" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
